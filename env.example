# Snowflake REST API Configuration
SNOWFLAKE_ACCOUNT_IDENTIFIER=your_account_identifier.your_region.snowflakecomputing.com
SNOWFLAKE_PAT=your_programmatic_access_token

# LaunchDarkly Configuration
LAUNCHDARKLY_SDK_KEY=sdk-xxxx-xxxx-xxxx
LAUNCHDARKLY_AI_CONFIG_KEY=gravity-farms-chatbot-config

# Demo Mode (set to true for testing without credentials)
DEMO_MODE=true

# Frontend API URL (for ChatWidget integration)
REACT_APP_API_URL=http://localhost:3001 