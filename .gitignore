# Environment files - NEVER commit these!
.env
.env.*
*.env
**/.env
**/.env.*

# Backup files
*.backup
*.bak

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Test scripts with sensitive data
test-*.sh
diagnose-*.sh
*-test.sh
*-test.js
test-*.js
diagnose-*.js

# SQL files that might contain credentials
*-setup.sql
*-policy.sql

# Temporary files
*.tmp
*.temp
.cache/

# Server logs that might contain secrets
server.log
**/server.log

# Shell scripts that might contain credentials
snowflake-rest-api-test.sh
setup-*.sh

# Any file with credentials or keys
*-credentials.*
*-keys.*
*.key
*.pem

.gitignore
